      "targets": [
        {
          "refId": "A",
          "expr": "sum by (upstream, backend) (rate(nginx_vts_upstream_requests_total[1m]))",
          "legendFormat": "{{upstream}} -> {{backend}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upstream responses / sec by status class",
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 30,
